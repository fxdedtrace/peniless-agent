# Copy to .env for local testing, or export these variables directly.
# On GitHub Actions these come from repo Secrets instead.

# Required: DeepSeek platform key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-key-here

# Required: your public USDC payout address (Phantom)
#   Base network:    0x...
#   Solana network:  your Solana address
AGENT_WALLET=0xYourPublicAddressHere

# Optional: which chain the x402 invoice targets — base | solana (default: base)
AGENT_NETWORK=base

# Optional: DeepSeek model (default: deepseek-flash; auto-falls back to
# deepseek-chat / deepseek-reasoner aliases if rejected)
DEEPSEEK_MODEL=deepseek-flash

# Optional: cap on solution length in tokens (default: 2048)
PENNILESS_MAX_TOKENS=2048
